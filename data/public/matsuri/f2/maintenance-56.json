  "evidence": [
    {
      "id": "evd-niihama-taiko-identity",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-current-2025",
      "target_type": "entity_identity",
      "target_id": "fst-niihama-taiko-matsuri",
      "assertion_code": "supports_entity_identity",
      "summary_ja": "新居浜市の公式ページは新居浜太鼓祭りを独立した祭りとして案内し、市内太鼓台、運行、かきくらべ、統一寄せを掲載している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-committee-identity",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-committee",
      "target_type": "entity_identity",
      "target_id": "org-niihama-taiko-matsuri-promotion-committee",
      "assertion_code": "supports_entity_identity",
      "summary_ja": "新居浜市は、市議会、市連合自治会、行政、地区運営組織、商工会議所、神社関係者、観光関係者などの代表で新居浜市太鼓祭り推進委員会を組織していると記録している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-state",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-held-2025",
      "target_type": "state_snapshot",
      "target_id": "sts-niihama-taiko-current",
      "assertion_code": "supports_current_state",
      "summary_ja": "2026年2月更新の新居浜市議会記録は、2025年の新居浜太鼓祭りが盛大に行われたと記録しており、祭りの活動継続を確認できる。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-recurrence",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-held-2025",
      "target_type": "recurrence_pattern",
      "target_id": "rec-niihama-taiko-annual",
      "assertion_code": "supports_recurrence",
      "summary_ja": "新居浜市議会記録は新居浜太鼓祭りを1年に一度の地方祭とし、市公式ページは2025年の10月15日から18日までの運行を掲載している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-citywide-place",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-committee",
      "target_type": "place",
      "target_id": "plc-niihama-taiko-citywide",
      "assertion_code": "supports_place",
      "summary_ja": "新居浜市は川西、川東、川東西部、船木、角野、泉川、中萩の各地区と所属太鼓台を掲載しており、祭りが市内の複数地区にまたがることを示している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-yamane-civic-ground-place",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-yamane-civic-ground-address",
      "target_type": "place",
      "target_id": "plc-yamane-civic-ground",
      "assertion_code": "supports_place",
      "summary_ja": "新居浜市条例は新居浜市山根市民グラウンドの位置を角野新田町三丁目2822番地の9と定め、市公式祭りページは上部地区統一寄せの会場として案内している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-rel-niihama-taiko-promotion-committee",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-committee",
      "target_type": "relation",
      "target_id": "rel-niihama-taiko-supported-by-promotion-committee",
      "assertion_code": "supports_relation",
      "summary_ja": "新居浜市は推進委員会が事故のない秋祭りの推進と太鼓祭りの観光化に関する事業を行うと記録しており、祭りを支援する関係を裏付ける。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-occ-2020",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-cancel-2020",
      "target_type": "occurrence",
      "target_id": "occ-niihama-taiko-2020",
      "assertion_code": "supports_occurrence",
      "summary_ja": "新居浜市の2020年10月号市政だよりは、その年の新居浜太鼓祭りが中止となったと記録している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-occ-2021",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-nonholding-2021",
      "target_type": "occurrence",
      "target_id": "occ-niihama-taiko-2021",
      "assertion_code": "supports_occurrence",
      "summary_ja": "新居浜市議会記録は、2021年に市長が太鼓台の組立てを含む運行自粛を要請し、全52台が自粛したと記録している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-occ-2022",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-return-2022",
      "target_type": "occurrence",
      "target_id": "occ-niihama-taiko-2022",
      "assertion_code": "supports_occurrence",
      "summary_ja": "新居浜市議会記録は、2022年の祭りが感染症対策を実施して3年ぶりに開催されたと記録している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-occ-2025-schedule",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-current-2025",
      "target_type": "occurrence",
      "target_id": "occ-niihama-taiko-2025",
      "assertion_code": "supports_occurrence",
      "summary_ja": "新居浜市の公式ページは2025年10月15日から18日までの4日間の主な運行予定を掲載している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-occ-2025-held",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-held-2025",
      "target_type": "occurrence",
      "target_id": "occ-niihama-taiko-2025",
      "assertion_code": "supports_occurrence",
      "summary_ja": "新居浜市議会記録は2025年の新居浜太鼓祭りが盛大に行われたと記録している。工場前かきくらべが中止されたため、全体規模は modified とする。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-suspension-2020",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-cancel-2020",
      "target_type": "change_event",
      "target_id": "chg-niihama-taiko-pandemic-suspension-2020",
      "assertion_code": "supports_change_event",
      "summary_ja": "新居浜市は2020年の祭り中止を記録し、別の市議会記録は2021年も全52台が運行を自粛したと記録している。Change Eventは公開太鼓台運行の中断に限定し、地域の祭礼文化全体の消滅を意味しない。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-return-2022",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-return-2022",
      "target_type": "change_event",
      "target_id": "chg-niihama-taiko-return-2022",
      "assertion_code": "supports_change_event",
      "summary_ja": "新居浜市議会記録は、2年間の自粛後、2022年に感染症対策を実施して3年ぶりに開催したと記録している。",
      "captured_at": "2026-08-05",
      "review_status": "approved"
    },
    {
      "id": "evd-niihama-taiko-format-2025",
      "schema_version": "common.v1",
      "record_version": 1,
      "source_id": "src-niihama-taiko-format-2025",
      "target_type": "change_event",
      "target_id": "chg-niihama-taiko-format-change-2025",
      "assertion_code": "supports_change_event",
      "summary_ja": "新居浜市議会記録は、関係企業からの要望と地区協議を受け、2025年の住友化学愛媛工場前かきくらべを中止した経緯を記録している。祭り全体の中止とは扱わない。",
