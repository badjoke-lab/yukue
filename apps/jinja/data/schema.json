{
  "format_version": 1,
  "site_id": "jinja",
  "entity_type": "shrine",
  "continuity_states": ["operating", "rebuilding", "relocated", "merged", "dissolved", "unknown"],
  "separate_dimensions": ["enshrinement_goshi", "corporate_status", "affiliation", "administration", "building_condition", "temporary_access", "disaster_damage"],
  "event_types": ["founded", "relocated", "transferred", "rebuilt", "destroyed", "damaged", "merged", "enshrined", "split_or_reestablished", "administration_changed", "corporate_status_changed", "affiliation_changed", "designation_added", "designation_changed", "designation_removed", "related_festival_changed", "other_reviewed_change"],
  "collections": {
    "entities": {
      "required": ["id", "canonical_name", "review_status", "tier", "verified_at"],
      "optional": ["reading", "aliases", "former_names", "current_place_id", "official_links", "enshrined_deities", "corporate_relation_ids", "affiliation_relation_ids", "notes"]
    },
    "states": {
      "required": ["id", "entity_id", "continuity_state", "review_status", "verified_at", "evidence_ids"],
      "optional": ["since", "basis_summary", "previous_state_id"]
    },
    "events": {
      "required": ["id", "entity_id", "event_type", "review_status", "evidence_ids"],
      "optional": ["date", "date_range", "title", "summary", "before", "after", "place_ids", "related_entity_ids"]
    },
    "relations": {
      "required": ["id", "source_entity_id", "target_entity_id", "relation_type", "review_status", "evidence_ids"],
      "optional": ["valid_from", "valid_to", "summary"]
    },
    "evidence": {
      "required": ["id", "target_type", "target_id", "source_id", "review_status", "verified_at", "summary"]
    },
    "sources": {
      "required": ["id", "title", "publisher", "url", "source_type", "accessed_at"],
      "optional": ["published_at"]
    },
    "places": {
      "required": ["id", "prefecture", "municipality", "review_status"],
      "optional": ["address", "latitude", "longitude", "verified_at"]
    }
  },
  "publication_rules": {
    "matsuri_relation_alone_is_not_tier_a": true,
    "missing_state_must_not_be_inferred": true,
    "unsupported_fields_are_absent": true,
    "html_and_machine_readable_share_canonical_records": true
  }
}
