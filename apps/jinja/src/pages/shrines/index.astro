---
import Container from "@badjoke-lab/yukue-ui/components/Container.astro";
import Section from "@badjoke-lab/yukue-ui/components/Section.astro";
import JinjaFrame from "../../components/JinjaFrame.astro";
import { approvedShrines } from "../../data/jinja.ts";
---

<JinjaFrame
  title="神社一覧 — 神社のゆくえ"
  description="掲載中の神社を一覧で見られます。"
  activeHref="/shrines/"
>
  <section class="list-hero">
    <Container size="wide">
      <h1>神社一覧</h1>
      <p>掲載中の神社を一覧で見られます。</p>
    </Container>
  </section>

  <Section title={`${approvedShrines.length}件`} rule="none">
    <div class="record-list">
      {approvedShrines.map(({ entity, place }) => (
        <a class="record-row" href={`/shrines/${entity.id}/`}>
          <span class="record-row__name">{entity.canonical_name}</span>
          <span>{place ? `${place.prefecture} ${place.municipality}` : "所在地未確認"}</span>
          <time>{entity.verified_at}</time>
        </a>
      ))}
    </div>
  </Section>
</JinjaFrame>

<style>
  .list-hero { padding-block: var(--space-14) var(--space-10); border-bottom: var(--rule-standard); }
  .list-hero h1 { margin: 0; font-size: var(--font-size-entity); font-weight: 500; letter-spacing: 0.08em; }
  .list-hero p { max-width: var(--container-prose); margin: var(--space-5) 0 0; color: var(--color-text-soft); }
  .record-list { border-top: var(--rule-strong); }
  .record-row { display: grid; grid-template-columns: minmax(12rem,1.4fr) minmax(10rem,1fr) 8rem; gap: var(--space-5); align-items: center; padding-block: var(--space-5); border-bottom: var(--rule-standard); color: var(--color-text); text-decoration: none; }
  .record-row__name { font-size: var(--font-size-h3); }
  .record-row span:not(.record-row__name), .record-row time { color: var(--color-muted); font-size: var(--font-size-sm); }
  @media (max-width: 720px) { .record-row { grid-template-columns: 1fr; gap: var(--space-1); } }
</style>
