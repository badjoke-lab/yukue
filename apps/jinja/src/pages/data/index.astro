---
import ActionLink from "@badjoke-lab/yukue-ui/components/ActionLink.astro";
import Container from "@badjoke-lab/yukue-ui/components/Container.astro";
import Section from "@badjoke-lab/yukue-ui/components/Section.astro";
import JinjaFrame from "../../components/JinjaFrame.astro";
import { approvedShrines } from "../../data/jinja.ts";
---

<JinjaFrame title="データ — 神社のゆくえ" description="掲載中のデータをJSONで利用できます。">
  <section class="page-hero">
    <Container size="wide">
      <h1>データ</h1>
      <p>掲載中のデータはJSONでも利用できます。</p>
    </Container>
  </section>

  <Section title="JSONデータ" rule="none">
    <div class="yk-prose">
      <p>現在は{approvedShrines.length}件の神社を収録しています。</p>
      <ActionLink href="/data/canonical.json" label="JSONを開く" />
    </div>
  </Section>
</JinjaFrame>

<style>
  .page-hero { padding-block: var(--space-14) var(--space-10); border-bottom: var(--rule-standard); }
  .page-hero h1 { margin: 0; font-size: var(--font-size-entity); font-weight: 500; letter-spacing: .06em; }
  .page-hero p { max-width: var(--container-prose); margin: var(--space-5) 0 0; color: var(--color-text-soft); }
</style>
