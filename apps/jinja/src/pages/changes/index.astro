---
import Container from "@badjoke-lab/yukue-ui/components/Container.astro";
import Section from "@badjoke-lab/yukue-ui/components/Section.astro";
import JinjaFrame from "../../components/JinjaFrame.astro";
---

<JinjaFrame title="変化の記録 — 神社のゆくえ" description="移転・遷座、合祀、再建など、確認できた変化を掲載します。" activeHref="/changes/">
  <section class="page-hero">
    <Container size="wide">
      <h1>変化の記録</h1>
      <p>移転・遷座、合祀、再建など、確認できた変化を掲載します。</p>
    </Container>
  </section>

  <Section title="掲載中の変化" rule="none">
    <p class="empty-state">現在、掲載している変化の記録はありません。</p>
  </Section>
</JinjaFrame>

<style>
  .page-hero { padding-block: var(--space-14) var(--space-10); border-bottom: var(--rule-standard); }
  .page-hero h1 { margin: 0; font-size: var(--font-size-entity); font-weight: 500; letter-spacing: .08em; }
  .page-hero p, .empty-state { max-width: var(--container-prose); color: var(--color-text-soft); }
  .page-hero p { margin: var(--space-5) 0 0; }
</style>
