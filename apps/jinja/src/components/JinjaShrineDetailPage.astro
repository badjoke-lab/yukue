---
import ActionLink from "@badjoke-lab/yukue-ui/components/ActionLink.astro";
import Container from "@badjoke-lab/yukue-ui/components/Container.astro";
import EvidenceList from "@badjoke-lab/yukue-ui/components/EvidenceList.astro";
import OverviewGrid from "@badjoke-lab/yukue-ui/components/OverviewGrid.astro";
import PlaceMap from "@badjoke-lab/yukue-ui/components/PlaceMap.astro";
import Section from "@badjoke-lab/yukue-ui/components/Section.astro";
import JinjaFrame from "./JinjaFrame.astro";
import { evidenceFor, findShrine } from "../data/jinja.ts";

interface Props { id: string; }
const { id } = Astro.props;
const record = findShrine(id);
if (!record) throw new Error(`Unknown Jinja shrine: ${id}`);
const { entity, place, state } = record;
const evidenceRecords = evidenceFor(entity.id);
const stateLabels: Record<string, string> = {
  operating: "継続（operating）",
  rebuilding: "再建中（rebuilding）",
  relocated: "移転・遷座後（relocated）",
  merged: "統合・合祀（merged）",
  dissolved: "解散・廃止（dissolved）",
  unknown: "未確認（unknown）",
};
const stateLabel = state ? (stateLabels[state.continuity_state] ?? state.continuity_state) : "未確認";
const latestVerifiedAt = state?.verified_at ?? entity.verified_at;

const overview = [
  { label: "所在地", value: place ? `${place.prefecture} ${place.municipality}` : "未確認" },
  { label: "Current State", value: stateLabel, accent: Boolean(state) },
  { label: "Review", value: `Tier ${entity.tier} / reviewed` },
  { label: "確認日", value: latestVerifiedAt },
];

const places = place ? [{
  name: entity.canonical_name,
  address: place.address,
  contextLabel: "神社",
}] : [];

const evidenceItems = evidenceRecords.map(({ evidence, source, targetLabel }) => ({
  id: evidence.id,
  targetLabel,
  sourceTitle: source?.title ?? evidence.source_id,
  supportSummary: evidence.summary,
  sourceHref: source?.url ?? entity.official_links[0],
}));
---

<JinjaFrame
  title={`${entity.canonical_name} — 神社のゆくえ`}
  description={`${entity.canonical_name}のreview済みIdentity、所在地、Current State、Change Event、Relation、Evidenceを表示する非canonicalプレビューです。`}
  activeHref="/shrines/"
>
  <article data-detail-page data-entity-id={entity.id}>
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <Container size="wide">
        <ol>
          <li><a href="/">ホーム</a></li>
          <li><a href="/shrines/">神社</a></li>
          {place && <li><a href="/regions/">{place.prefecture}</a></li>}
          <li aria-current="page">{entity.canonical_name}</li>
        </ol>
      </Container>
    </nav>

    <section class="entity-identity" id="identity">
      <Container size="wide">
        <p class="entity-identity__kicker">Shrine Record</p>
        <h1>{entity.canonical_name}</h1>
        <ul class="entity-identity__meta" aria-label="基本分類">
          <li>神社</li>
          {place && <li>{place.prefecture} {place.municipality}</li>}
          <li>Tier {entity.tier}</li>
        </ul>
        <div class="entity-identity__actions" aria-label="記録への導線">
          {entity.official_links[0] && <ActionLink href={entity.official_links[0]} label="公式情報を見る" />}
          <ActionLink href="/data/canonical.json" label="公開JSONを見る" />
          <ActionLink href="/about/#corrections" label="この記録の訂正を連絡する" />
        </div>
      </Container>
    </section>

    <Section kicker="Integrated Overview" title="現在確認できていること" id="current">
      <OverviewGrid items={overview} />
      {state ? (
        <div class="state-explanation" data-reviewed-current-state>
          <h3>Current State: {stateLabel}</h3>
          <p>{state.basis_summary}</p>
          <p>確認日: {state.verified_at}。この判定はStateに直接結び付く公式Evidenceからreviewしたもので、公式URLの存在だけから推測したものではありません。</p>
        </div>
      ) : (
        <div class="state-explanation">
          <h3>Current Stateは未確認です</h3>
          <p>継続、休止、遷座、合祀、再建、兼務、法人状態などは、対応するEvidenceを確認するまで推測で補いません。</p>
        </div>
      )}
    </Section>

    {places.length > 0 && (
      <Section kicker="Places & Map" title="所在地" id="places">
        <PlaceMap places={places} contextDescription="review済みの公式情報で確認した現在所在地です。" />
      </Section>
    )}

    <Section kicker="Change History" title="これまでの変化" id="changes">
      <p class="empty-state">review済みChange Eventはまだありません。</p>
    </Section>

    <Section kicker="Connections / Relations" title="関係" id="relations">
      <p class="empty-state">review済みRelationはまだありません。関連祭礼・神社・寺院・組織との関係は、根拠確認後に追加します。</p>
    </Section>

    {evidenceItems.length > 0 && (
      <Section kicker="Evidence & Sources" title="判断根拠と出典" id="evidence">
        <p class="section-intro">どの確認事項を、どの資料が支えているかを対応させています。</p>
        <EvidenceList items={evidenceItems} />
      </Section>
    )}

    <Section kicker="Record Updates" title="この記録の更新" id="record-updates">
      <ol class="record-updates">
        {state && (
          <li>
            <time>{state.verified_at}</time>
            <div>
              <h3>Current State review</h3>
              <p>{stateLabel}を公式Evidenceから確認しました。</p>
            </div>
          </li>
        )}
        <li>
          <time>{entity.verified_at}</time>
          <div>
            <h3>Identity / Geography review</h3>
            <p>神社名、所在地、公式SourceをTier {entity.tier}としてreviewしました。</p>
          </div>
        </li>
      </ol>
    </Section>

    <Section kicker="Machine-readable Data" title="機械可読データ" id="machine-data" rule="none">
      <div class="machine-data">
        <p>このpreviewのreview済みcanonicalデータをJSONで確認できます。</p>
        <ActionLink href="/data/canonical.json" label="canonical preview JSONを開く" />
        <ActionLink href="/data/" label="公開データについて" />
      </div>
    </Section>
  </article>
</JinjaFrame>

<style>
  .breadcrumb { padding-block: var(--space-4); border-bottom: var(--rule-standard); }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; color: var(--color-muted); font-size: var(--font-size-xs); }
  .breadcrumb li:not(:last-child)::after { content: "／"; margin-left: var(--space-2); color: var(--color-rule-strong); }
  .breadcrumb a { color: inherit; }
  .entity-identity { padding-block: var(--space-14) var(--space-10); border-bottom: var(--rule-standard); }
  .entity-identity__kicker { margin: 0 0 var(--space-3); color: var(--color-accent); font-size: var(--font-size-sm); letter-spacing: 0.12em; }
  .entity-identity h1 { margin: 0; font-size: var(--font-size-entity); font-weight: 500; letter-spacing: 0.08em; }
  .entity-identity__meta { display: flex; flex-wrap: wrap; gap: var(--space-4); margin: var(--space-6) 0 0; padding: 0; list-style: none; color: var(--color-text-soft); font-size: var(--font-size-sm); }
  .entity-identity__meta li + li { padding-left: var(--space-4); border-left: var(--rule-standard); }
  .entity-identity__actions, .machine-data { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .entity-identity__actions { margin-top: var(--space-8); }
  .state-explanation, .section-intro, .machine-data p, .empty-state { max-width: var(--container-prose); color: var(--color-text-soft); }
  .state-explanation { margin-top: var(--space-8); padding-top: var(--space-6); border-top: var(--rule-standard); }
  .state-explanation h3, .record-updates h3 { margin: 0; font-size: var(--font-size-h3); font-weight: 500; }
  .state-explanation p, .record-updates p { margin: var(--space-3) 0 0; }
  .record-updates { display: grid; gap: 0; margin: 0; padding: 0; border-top: var(--rule-strong); list-style: none; }
  .record-updates li { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: var(--space-8); padding-block: var(--space-6); border-bottom: var(--rule-standard); }
  .record-updates time { color: var(--color-muted); font-size: var(--font-size-sm); }
  .machine-data { align-items: center; }
  .machine-data p { flex-basis: 100%; margin: 0; }
  @media (max-width: 640px) {
    .entity-identity { padding-block: var(--space-10) var(--space-8); }
    .entity-identity__meta { display: grid; gap: var(--space-2); }
    .entity-identity__meta li + li { padding-left: 0; border-left: 0; }
    .record-updates li { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
