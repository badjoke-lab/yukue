{
  "name": "@badjoke-lab/yukue-jinja",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @badjoke-lab/yukue-matsuri exec astro dev --root ../jinja",
    "build": "pnpm --filter @badjoke-lab/yukue-matsuri exec astro build --root ../jinja",
    "check": "node scripts/check.mjs && node scripts/check-data.mjs && node scripts/audit-tier-a-candidates.mjs --summary",
    "typecheck": "node scripts/check.mjs && node scripts/check-data.mjs",
    "audit:tier-a-candidates": "node scripts/audit-tier-a-candidates.mjs"
  }
}
