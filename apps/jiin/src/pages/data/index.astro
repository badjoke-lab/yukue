---
import Container from "@badjoke-lab/yukue-ui/components/Container.astro";
import Section from "@badjoke-lab/yukue-ui/components/Section.astro";
import JiinFrame from "../../components/JiinFrame.astro";
---

<JiinFrame title="データ — 寺院のゆくえ" description="寺院のゆくえの公開データ方針を説明します。">
  <Section title="データ">
    <Container size="prose">
      <p>公開ページと同じ、確認済みの寺院記録から機械可読データを生成する方針です。</p>
      <p>現在のpreviewでは、公開対象として確認済みの寺院データセットはまだ提供していません。候補や調査途中の情報を公開データとして扱いません。</p>
    </Container>
  </Section>
</JiinFrame>
