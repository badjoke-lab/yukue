---
import Container from "@badjoke-lab/yukue-ui/components/Container.astro";
import Section from "@badjoke-lab/yukue-ui/components/Section.astro";
import JiinFrame from "../../../components/JiinFrame.astro";
import { approvedTemples, evidenceFor } from "../../../data/jiin.ts";

export function getStaticPaths() {
  return approvedTemples.map(({ entity, place, state }) => ({
    params: { id: entity.id },
    props: { entity, place, state },
  }));
}

const { entity, place, state } = Astro.props;
const evidence = evidenceFor(entity.id);
---

<JiinFrame title={`${entity.canonical_name} — 寺院のゆくえ`} description={`${entity.canonical_name}の所在地、現在の状況、確認済みの根拠を掲載します。`} activeHref="/temples/">
  <section class="detail-hero">
    <Container size="wide">
      <p class="kicker">Tier {entity.tier} / 確認日 {entity.verified_at}</p>
      <h1>{entity.canonical_name}</h1>
      {entity.reading && <p class="reading">{entity.reading}</p>}
      <p class="location">{place ? `${place.prefecture} ${place.municipality}${place.address ? ` ${place.address}` : ""}` : "所在地未確認"}</p>
    </Container>
  </section>

  <Section title="基本情報">
    <dl class="facts">
      <div><dt>名称</dt><dd>{entity.canonical_name}</dd></div>
      {entity.mountain_name && <div><dt>山号</dt><dd>{entity.mountain_name}</dd></div>}
      {entity.in_name && <div><dt>院号</dt><dd>{entity.in_name}</dd></div>}
      <div><dt>所在地</dt><dd>{place ? `${place.prefecture} ${place.municipality}${place.address ? ` ${place.address}` : ""}` : "未確認"}</dd></div>
      <div><dt>現在状態</dt><dd>{state?.continuity_state ?? "根拠未確認のため未掲載"}</dd></div>
    </dl>
  </Section>

  <Section title="出典と確認" rule="none">
    {evidence.length > 0 ? (
      <div class="evidence-list">
        {evidence.map(({ evidence: item, source, targetLabel }) => (
          <article>
            <p class="evidence-label">{targetLabel} / {item.verified_at}</p>
            <p>{item.summary}</p>
            {source && <p><a href={source.url} rel="noreferrer">{source.publisher} — {source.title}</a></p>}
          </article>
        ))}
      </div>
    ) : <p class="empty">公開可能な根拠資料はありません。</p>}
  </Section>
</JiinFrame>

<style>
  .detail-hero { padding-block: var(--space-16) var(--space-12); border-bottom: var(--rule-standard); }
  .kicker { margin: 0 0 var(--space-3); color: var(--color-accent); font-size: var(--font-size-sm); }
  .detail-hero h1 { margin: 0; font-size: var(--font-size-entity); font-weight: 500; }
  .reading, .location { margin: var(--space-2) 0 0; color: var(--color-text-soft); }
  .facts { margin: 0; border-top: var(--rule-strong); }
  .facts div { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: var(--space-6); padding-block: var(--space-4); border-bottom: var(--rule-standard); }
  .facts dt { color: var(--color-muted); }
  .facts dd { margin: 0; }
  .evidence-list { border-top: var(--rule-strong); }
  .evidence-list article { padding-block: var(--space-5); border-bottom: var(--rule-standard); }
  .evidence-list p { margin: 0; }
  .evidence-list p + p { margin-top: var(--space-2); }
  .evidence-label, .empty { color: var(--color-muted); font-size: var(--font-size-sm); }
  @media (max-width: 640px) { .facts div { grid-template-columns: 1fr; gap: var(--space-1); } }
</style>
